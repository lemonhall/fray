{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "web",
  "cleanUrls": true,
  "build": {
    "env": {
      "FRAY_API": "https://fray-api.lemonhall2012.workers.dev"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
